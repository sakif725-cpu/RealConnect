<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calling_gradient"
    android:padding="20dp">

    <!-- Grabber Handle -->
    <View
        android:id="@+id/transcript_grabber"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#44FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/layout_transcript_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/transcript_grabber">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_transcript"
            app:tint="#38BDF8" />

        <TextView
            android:id="@+id/text_live_transcript_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Live Speech Transcript"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2210B981"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#10B981"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_badge_counter"
                    android:backgroundTint="#10B981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="LIVE"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Sandbox Path Banner -->
    <TextView
        android:id="@+id/text_transcript_path_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#0F172A"
        android:fontFamily="monospace"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="Saving to: /profile/privacy/TranscriptsLog/transcript.txt"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/layout_transcript_header" />

    <!-- Live Transcript Scroll Box -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_transcript_box"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/text_transcript_path_banner">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_live_transcript"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="14dp">

            <TextView
                android:id="@+id/text_live_transcript_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="5dp"
                android:text="🎙️ Listening to live audio stream...\nSpeak into the microphone to see real-time transcription."
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:textIsSelectable="true" />
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layout_transcript_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/card_transcript_box">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_live_transcript"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Copy Text"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="#44FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_live_transcript"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:text="Close"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
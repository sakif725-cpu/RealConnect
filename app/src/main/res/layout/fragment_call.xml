<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ============================================== -->
    <!-- VIEW 1: RECENT CALL LOGS (DEFAULT INITIAL VIEW) -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_call_logs_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Header -->
        <TextView
            android:id="@+id/text_call_logs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Recents"
            android:textColor="@color/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Clear Logs Text Button -->
        <TextView
            android:id="@+id/btn_clear_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:padding="8dp"
            android:text="Clear"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/text_call_logs_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_call_logs_title" />

        <!-- Call Logs Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_call_logs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_call_logs_title"
            tools:listitem="@layout/item_call_log" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_call_logs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_call_logs_title">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_call"
                app:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No recent calls"
                android:textColor="@color/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calls you make or receive will appear here"
                android:textColor="@color/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Floating Action Button to open Num Pad / Keypad -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_open_dialpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="96dp"
            android:contentDescription="Open Keypad"
            android:src="@drawable/ic_dialpad"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- VIEW 2: NUM PAD / KEYPAD DIALER SCREEN          -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_dialer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:padding="20dp"
        android:visibility="gone">

        <!-- Back to Recents Button -->
        <ImageButton
            android:id="@+id/btn_close_dialpad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Recents"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/textColorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Keypad"
            android:textColor="@color/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btn_close_dialpad"
            app:layout_constraintStart_toEndOf="@id/btn_close_dialpad"
            app:layout_constraintTop_toTopOf="@id/btn_close_dialpad" />

        <TextView
            android:id="@+id/text_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/colorPrimary"
            android:textSize="17sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_close_dialpad" />

        <TextView
            android:id="@+id/text_phone_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/textColorPrimary"
            android:textSize="34sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_delete"
            app:layout_constraintStart_toEndOf="@+id/btn_add_to_contacts"
            app:layout_constraintTop_toBottomOf="@id/text_contact_name" />

        <ImageButton
            android:id="@+id/btn_add_to_contacts"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_contact"
            android:src="@drawable/ic_add"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/text_phone_number"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_phone_number"
            app:tint="@color/colorPrimary" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/backspace"
            android:src="@drawable/ic_backspace"
            app:layout_constraintBottom_toBottomOf="@+id/text_phone_number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_phone_number"
            app:tint="@color/textColorSecondary" />

        <GridLayout
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:useDefaultMargins="true"
            app:layout_constraintBottom_toTopOf="@+id/btn_make_call"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_phone_number">

            <Button android:id="@+id/btn_1" style="@style/DialerButton" android:text="1" />
            <Button android:id="@+id/btn_2" style="@style/DialerButton" android:text="2" />
            <Button android:id="@+id/btn_3" style="@style/DialerButton" android:text="3" />

            <Button android:id="@+id/btn_4" style="@style/DialerButton" android:text="4" />
            <Button android:id="@+id/btn_5" style="@style/DialerButton" android:text="5" />
            <Button android:id="@+id/btn_6" style="@style/DialerButton" android:text="6" />

            <Button android:id="@+id/btn_7" style="@style/DialerButton" android:text="7" />
            <Button android:id="@+id/btn_8" style="@style/DialerButton" android:text="8" />
            <Button android:id="@+id/btn_9" style="@style/DialerButton" android:text="9" />

            <Button android:id="@+id/btn_star" style="@style/DialerButton" android:text="*" />
            <Button android:id="@+id/btn_0" style="@style/DialerButton" android:text="0" />
            <Button android:id="@+id/btn_hash" style="@style/DialerButton" android:text="#" />
        </GridLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_make_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/make_call"
            android:src="@drawable/ic_call"
            app:backgroundTint="#22C55E"
            app:fabSize="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
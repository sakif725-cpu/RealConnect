<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_contact_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#F1F5F9"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/image_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_contacts" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/text_contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/textColorPrimary"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/image_message_action"
        app:layout_constraintStart_toEndOf="@id/card_contact_avatar"
        app:layout_constraintTop_toTopOf="@id/card_contact_avatar"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/text_contact_phone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/textColorSecondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/card_contact_avatar"
        app:layout_constraintEnd_toEndOf="@id/text_contact_name"
        app:layout_constraintStart_toStartOf="@id/text_contact_name"
        app:layout_constraintTop_toBottomOf="@id/text_contact_name" />

    <ImageView
        android:id="@+id/image_message_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_chat"
        android:contentDescription="Chat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/image_call_action"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#60A5FA" />

    <ImageView
        android:id="@+id/image_call_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_call"
        android:contentDescription="@string/make_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#22C55E" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_contact_name"
        app:layout_constraintTop_toBottomOf="@id/card_contact_avatar" />

</androidx.constraintlayout.widget.ConstraintLayout>
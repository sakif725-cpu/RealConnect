<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp">

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_log_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardBackgroundColor="#F1F5F9"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_log_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="11dp"
            android:src="@drawable/ic_contacts"
            app:tint="@color/colorPrimary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Name / Phone -->
    <TextView
        android:id="@+id/text_log_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/image_log_call_action"
        app:layout_constraintStart_toEndOf="@id/card_log_avatar"
        app:layout_constraintTop_toTopOf="@id/card_log_avatar"
        tools:text="Alice Smith" />

    <!-- Direction Icon & Call Type / Time Subtitle -->
    <LinearLayout
        android:id="@+id/layout_log_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/image_log_call_action"
        app:layout_constraintStart_toEndOf="@id/card_log_avatar"
        app:layout_constraintTop_toBottomOf="@id/text_log_name">

        <ImageView
            android:id="@+id/img_log_direction"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_call_incoming"
            app:tint="#22C55E" />

        <TextView
            android:id="@+id/text_log_type_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            tools:text="Incoming • 10:45 AM (01:23)" />
    </LinearLayout>

    <!-- Redial Action Button -->
    <ImageView
        android:id="@+id/image_log_call_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Call"
        android:padding="8dp"
        android:src="@drawable/ic_call"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#22C55E" />

    <!-- Divider -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/text_log_name" />

</androidx.constraintlayout.widget.ConstraintLayout>
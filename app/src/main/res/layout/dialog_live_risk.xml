<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_calling_gradient"
    android:padding="20dp">

    <!-- Grabber Handle -->
    <View
        android:id="@+id/risk_grabber"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#44FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/text_risk_modal_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🛡️ AI Live Call Risk Inspector"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/risk_grabber" />

    <!-- Risk Level Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_risk_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#22EF4444"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#EF4444"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toBottomOf="@id/text_risk_modal_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_risk_level_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGH RISK (85%)"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/icon_risk_status"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_block"
                    app:tint="#EF4444" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_risk_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Potential financial fraud / robocall detected"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Threat Indicators Container -->
    <TextView
        android:id="@+id/text_indicators_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.05"
        android:text="SECURITY SCAN INDICATORS"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_risk_score" />

    <LinearLayout
        android:id="@+id/layout_indicators_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/text_indicators_header">

        <TextView
            android:id="@+id/text_indicator_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            tools:text="• Telemarketing / Robocall Prefix" />

        <TextView
            android:id="@+id/text_indicator_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            tools:text="• Voice Biomarkers: Synthetic Speech" />

        <TextView
            android:id="@+id/text_indicator_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            tools:text="• Caller Reputation: Flagged by AI" />
    </LinearLayout>

    <!-- Recommendation Box -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_recommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/layout_indicators_list">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 AI RECOMMENDATION"
                android:textColor="#60A5FA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_risk_recommendation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Never share OTP, passwords, or bank card CVV numbers over the phone. Hang up if pressured."
                android:textColor="#F8FAFC"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dismiss_risk_modal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="Got It • Continue Monitoring"
        android:textColor="@color/white"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/card_recommendation" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp">

    <!-- Top Back Button -->
    <ImageButton
        android:id="@+id/btn_auth_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Center Card / Form -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- STEP 1: SIGN IN / PHONE & GOOGLE -->
                <LinearLayout
                    android:id="@+id/layout_step_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome to RealConnect"
                        android:textColor="#38BDF8"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="1-Tap Sign In"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sign in to receive your unique 13-digit virtual calling ID with zero manual configuration."
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />

                    <!-- GOOGLE SIGN IN BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_google_sign_in"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Continue with Google"
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="3dp"
                        app:icon="@drawable/ic_google_logo"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconSize="22dp"
                        app:iconTint="@null" />

                    <!-- INSTANT AUTO-ASSIGN BUTTON (DEMO / GUEST) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_instant_access"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#1E3A8A"
                        android:text="⚡ 1-Tap Auto-Assign 13-Digit ID"
                        android:textColor="#93C5FD"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="1dp"
                        app:strokeColor="#3B82F6"
                        app:strokeWidth="1dp" />

                    <!-- DIVIDER WITH 'OR' -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#334155" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:text="OR ENTER CUSTOM NUMBER"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#334155" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edit_phone_input"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_auth_input"
                        android:drawableStart="@drawable/ic_call"
                        android:drawablePadding="12dp"
                        android:drawableTint="#38BDF8"
                        android:hint="9100000000001"
                        android:inputType="phone"
                        android:maxLength="15"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#64748B"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_otp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#0EA5E9"
                        android:text="Continue with Number"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="2dp" />

                </LinearLayout>

                <!-- STEP 2: OTP VERIFICATION -->
                <LinearLayout
                    android:id="@+id/layout_step_otp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verification"
                        android:textColor="#38BDF8"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Enter OTP Code"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_otp_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Enter the 4-digit code sent to your phone."
                        android:textColor="#94A3B8"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edit_otp_input"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_auth_input"
                        android:gravity="center"
                        android:hint="• • • •"
                        android:inputType="number"
                        android:letterSpacing="0.4"
                        android:maxLength="6"
                        android:textColor="@color/white"
                        android:textColorHint="#64748B"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_verify_otp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#0EA5E9"
                        android:text="Verify &amp; Continue"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="2dp" />

                    <TextView
                        android:id="@+id/btn_change_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:padding="8dp"
                        android:text="Change number"
                        android:textColor="#38BDF8"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- LOADING OVERLAY -->
            <FrameLayout
                android:id="@+id/layout_loading_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#DD0F172A"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="#38BDF8" />

                    <TextView
                        android:id="@+id/text_loading_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Assigning unique 13-digit calling ID..."
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
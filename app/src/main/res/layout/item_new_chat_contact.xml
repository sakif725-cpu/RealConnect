<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <!-- Avatar Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_sheet_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:cardBackgroundColor="#F0F9FF"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="#BAE6FD"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_sheet_avatar_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#0284C7"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="J" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Name & Phone -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_sheet_item_chat"
        app:layout_constraintStart_toEndOf="@id/card_sheet_avatar"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_sheet_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Jane Doe" />

        <TextView
            android:id="@+id/text_sheet_contact_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/textColorSecondary"
            android:textSize="13sp"
            tools:text="+1 (555) 234-5678" />
    </LinearLayout>

    <!-- Chat Action Pill / Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_sheet_item_chat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:cardBackgroundColor="#F0F9FF"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#BAE6FD"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_chat"
            app:tint="#0284C7" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

